# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env commit edilmez.

# ---------------------------------------------------------------------------
# Google Analytics (opsiyonel)
# Tanımlı değilse GA script'i hiç yüklenmez.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Supabase — yönetim paneli için ZORUNLU
#
# Nereden alınır: Supabase panelinde projeyi açın →
#   Project Settings → API
#
#   NEXT_PUBLIC_SUPABASE_URL       = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = "anon / public" anahtarı
#
# anon anahtarı tarayıcıya gider; güvenliği Row Level Security sağlar
# (bkz. supabase/migrations/0003_rls_policies.sql). Bu normaldir.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Sitenin kendi adresi — QR kodlarının içine gömülecek mutlak URL için.
# Vercel'de otomatik gelen VERCEL_URL yerine bunu kullanın; preview
# deploy'larda QR'lar kalıcı adrese işaret etmeli.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://altinozbobinaj.com
